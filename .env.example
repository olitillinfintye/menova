# --- Vercel Blob -------------------------------------------------------------
# Created automatically when you link a Blob store: `vercel env pull .env.local`
BLOB_READ_WRITE_TOKEN=

# --- Vercel Postgres ---------------------------------------------------------
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# --- Auth --------------------------------------------------------------------
# 32+ random bytes, used to HMAC the session cookie: `openssl rand -hex 32`
AUTH_SECRET=
# Optional machine token for server-to-server calls: `Authorization: Bearer <token>`
MENOVA_API_TOKEN=
# Set to "true" ONLY for local development. Treats every caller as the
# "public" owner so you can use the dashboard without an auth provider.
ALLOW_ANONYMOUS=true

# --- CORS --------------------------------------------------------------------
# Comma separated list of allowed origins, or "*" to allow any origin.
# Leave empty to allow same-origin requests only.
ALLOWED_ORIGINS=

# --- Client ------------------------------------------------------------------
# Absolute origin used when building shareable viewer links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Draco decoder location (must end with a slash).
NEXT_PUBLIC_DRACO_DECODER_PATH=https://www.gstatic.com/draco/versioned/decoders/1.5.7/
